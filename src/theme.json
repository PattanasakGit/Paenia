{
  "version": 1,
  "themeSettings": {
    "workbench.colorTheme": "Default Dark Modern",
    "glass.theme.detectColorScheme": false,
    "glass.theme.settingsId": "Default Dark Modern",
    "glass.theme.darkSettingsId": "Default Dark Modern",
    "glass.theme.customTintHue": 188,
    "glass.theme.customTintIntensity": 30
  },
  "colors": {
    "bg0": "#08060F",
    "bg1": "#100B1F",
    "bg2": "#17102A",
    "bg3": "#241642",
    "bg4": "#34205F",
    "fg0": "#FFF7FF",
    "fg1": "#E9D7FF",
    "fg2": "#B79CFF",
    "muted": "#7C6A99",
    "muted2": "#534566",
    "border": "#9D4EDD",
    "accent": "#FF4FD8",
    "accentSoft": "#FF9BE8",
    "blue": "#00D4FF",
    "green": "#5CFF95",
    "red": "#FF3864",
    "purple": "#C77DFF",
    "transparent": "#FFFFFF00",
    "overlayLow": "#FFFFFF08",
    "overlayMid": "#FFFFFF10",
    "overlayHigh": "#FFFFFF18",
    "overlayActive": "#FFFFFF22"
  },
  "ui": {
    "editor.background": "$bg0",
    "sideBar.background": "$bg1",
    "activityBar.background": "$bg0",
    "panel.background": "$bg1",
    "terminal.background": "#090B0C",
    "terminal.foreground": "$fg1",
    "terminalCursor.foreground": "$accent",
    "titleBar.activeBackground": "$bg0",
    "titleBar.inactiveBackground": "$bg0",
    "editorGutter.background": "$bg0",
    "editorGroupHeader.tabsBackground": "$bg0",
    "editorGroupHeader.noTabsBackground": "$bg0",
    "tab.activeBackground": "$bg0",
    "tab.inactiveBackground": "$bg1",
    "tab.unfocusedActiveBackground": "$bg0",
    "tab.unfocusedInactiveBackground": "$bg1",
    "sideBarSectionHeader.background": "$bg1",
    "secondarySideBar.background": "$bg1",
    "minimap.background": "$bg0",
    "statusBar.background": "$bg0",

    "contrastBorder": "$border",
    "panel.border": "$border",
    "sideBar.border": "$border",
    "activityBar.border": "$border",
    "editorGroup.border": "$border",
    "editorGroupHeader.border": "$border",
    "tab.border": "$bg3",
    "titleBar.border": "$border",
    "statusBar.border": "$border",
    "input.border": "$border",
    "commandCenter.border": "$border",
    "widget.border": "$border",
    "editorWidget.border": "$border",
    "editorWidget.resizeBorder": "$accent",
    "sash.hoverBorder": "$accent",
    "focusBorder": "$accent",

    "activityBar.activeBorder": "$accent",
    "activityBarTop.activeBorder": "$accent",
    "activityBarBadge.background": "$accent",
    "activityBarBadge.foreground": "$bg0",
    "progressBar.background": "$accent",
    "settings.modifiedItemIndicator": "$accent",
    "panelTitle.activeBorder": "$accent",
    "inputOption.activeBorder": "$accent",
    "tab.activeBorder": "$accent33",
    "tab.activeBorderTop": "$accent33",
    "tab.unfocusedActiveBorder": "$accent66",
    "tab.unfocusedActiveBorderTop": "$accent33",
    "tab.activeModifiedBorder": "$accent",
    "statusBarItem.remoteBackground": "$accent",
    "statusBarItem.remoteForeground": "$bg0",
    "statusBarItem.remoteHoverBackground": "$accentSoft",
    "statusBarItem.remoteHoverForeground": "$bg0",
    "notebook.inactiveFocusedCellBorder": "$accent",
    "commandCenter.activeBorder": "$border",

    "sideBar.foreground": "$fg1",
    "sideBarTitle.foreground": "$fg0",
    "sideBarSectionHeader.foreground": "$fg2",
    "list.activeSelectionBackground": "$bg4",
    "list.inactiveSelectionBackground": "$bg3",
    "list.hoverBackground": "$bg3",
    "list.activeSelectionForeground": "$accentSoft",
    "list.inactiveSelectionForeground": "$accent",
    "list.hoverForeground": "$fg0",
    "list.highlightForeground": "$accent",
    "list.activeSelectionIconForeground": "$accentSoft",
    "list.inactiveSelectionIconForeground": "$accent",
    "breadcrumb.activeSelectionForeground": "$accentSoft",
    "menu.selectionForeground": "$accentSoft",
    "menubar.selectionForeground": "$accentSoft",
    "notificationLink.foreground": "$accent",
    "editorSuggestWidget.highlightForeground": "$accent",
    "pickerGroup.foreground": "$accent",
    "textLink.foreground": "$blue",
    "chat.slashCommandForeground": "$accent",
    "chat.avatarForeground": "$accent",

    "input.background": "$bg2",
    "dropdown.background": "$bg2",
    "quickInput.background": "$bg2",
    "quickInputTitle.background": "$bg1",
    "quickInputList.focusBackground": "$bg4",
    "quickInputList.focusForeground": "$accentSoft",
    "editorWidget.background": "$bg2",

    "editor.lineHighlightBackground": "$overlayLow",
    "editor.lineHighlightBorder": "$transparent",
    "editorIndentGuide.background1": "$bg4",
    "editorIndentGuide.activeBackground1": "#3A4650",
    "editorLineNumber.foreground": "$muted2",
    "editorLineNumber.activeForeground": "$accent",
    "editor.findMatchBorder": "$accent",
    "selection.background": "$accent40",

    "button.background": "$accent",
    "button.hoverBackground": "$accentSoft",
    "button.foreground": "$bg0",
    "toolbar.activeBackground": "$bg4",
    "extensionButton.foreground": "$bg0",
    "extensionButton.separator": "$accent",
    "extensionButton.background": "$accent",
    "extensionButton.hoverBackground": "$accentSoft",
    "extensionButton.prominentForeground": "$bg0",
    "extensionButton.prominentBackground": "$accent",
    "extensionButton.prominentHoverBackground": "$accentSoft",

    "scrollbarSlider.background": "$overlayMid",
    "scrollbarSlider.hoverBackground": "$overlayHigh",
    "scrollbarSlider.activeBackground": "$overlayActive",
    "scrollbarSlider.hoverBorder": "$transparent",
    "scrollbarSlider.activeBorder": "$transparent",

    "gitDecoration.modifiedResourceForeground": "$accent",
    "gitDecoration.addedResourceForeground": "$green",
    "gitDecoration.deletedResourceForeground": "$red",
    "gitDecoration.untrackedResourceForeground": "$green",
    "gitDecoration.ignoredResourceForeground": "$muted2",
    "gitDecoration.conflictingResourceForeground": "$purple",
    "gitDecoration.stageModifiedResourceForeground": "$accentSoft",
    "gitDecoration.stageDeletedResourceForeground": "$red"
  },
  "uiOverrides": {},
  "tokenRules": [
    { "scope": ["comment", "punctuation.definition.comment"], "foreground": "$muted" },
    { "scope": ["comment.documentation", "comment.block.documentation"], "foreground": "#7D858C" },
    { "scope": ["keyword", "keyword.control", "storage.type", "storage.modifier"], "foreground": "$accent" },
    { "scope": ["entity.name.tag", "entity.name.attribute-name"], "foreground": "$blue" },
    { "scope": ["keyword.operator"], "foreground": "$fg1" },
    { "scope": ["variable", "variable.other.readwrite", "support.variable"], "foreground": "$fg0" },
    { "scope": ["variable.parameter"], "foreground": "$accentSoft" },
    { "scope": ["variable.language.this", "support.variable.magic"], "foreground": "$red" },
    { "scope": ["entity.name.type", "entity.name.class", "support.type", "entity.name.namespace", "entity.name.function.constructor"], "foreground": "$purple" },
    { "scope": ["variable.object.property", "variable.other.property", "support.type.property-name"], "foreground": "$fg1" },
    { "scope": ["entity.name.decorator", "meta.decorator", "storage.type.annotation"], "foreground": "$accentSoft" },
    { "scope": ["entity.name.function", "support.function", "meta.function-call entity.name.function"], "foreground": "$blue", "fontStyle": "" },
    { "scope": ["string", "string.quoted"], "foreground": "$green" },
    { "scope": ["constant.numeric"], "foreground": "$purple" },
    { "scope": ["constant.language", "constant.other"], "foreground": "$accentSoft" },
    { "scope": ["punctuation.section.block", "punctuation.section.bracket", "punctuation.section.parens"], "foreground": "$fg2" },
    { "scope": ["punctuation.definition.string"], "foreground": "$green" },
    { "scope": ["punctuation.separator", "punctuation.terminator"], "foreground": "$fg2" }
  ]
}
